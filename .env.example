PORT=8101

# --- PayPhone ---
# Producción: se usan cuando el Origin es metodosk.ec (o desconocido).
PAYPHONE_TOKEN=tu_token_de_produccion
# Pruebas: se usan desde localhost, túneles y previews de Vercel.
PAYPHONE_TEST_TOKEN=tu_token_de_develop

# --- Precios en CENTAVOS ---
# Deben coincidir con metodosk-frontapp/src/config/payment.ts
PRESALE_PRICE_CENTS=6700
REGULAR_PRICE_CENTS=8700
PRESALE_DEADLINE=2026-09-07T23:59:59-05:00

# --- Orígenes extra permitidos (opcional, separados por coma) ---
CORS_ORIGINS=

# --- Base de datos (OPCIONAL) ---
# Sin DB_URI el API funciona igual, pero no guarda registro de los pedidos.
DB_URI=

SLACK_ERROR_WEBHOOK=
