PORT=8101

# --- PayPhone ---
# Producción: se usan cuando el Origin es metodosk.ec (o desconocido).
PAYPHONE_TOKEN=tu_token_de_produccion
# Pruebas: se usan desde localhost, túneles y previews de Vercel.
PAYPHONE_TEST_TOKEN=tu_token_de_develop

# --- Precios en CENTAVOS ---
# Deben coincidir con metodosk-frontapp/src/config/payment.ts
PRESALE_PRICE_CENTS=6700
REGULAR_PRICE_CENTS=8700
PRESALE_DEADLINE=2026-09-07T23:59:59-05:00

# --- Orígenes extra permitidos (opcional, separados por coma) ---
CORS_ORIGINS=

# --- Base de datos (OPCIONAL) ---
# Sin DB_URI el API funciona igual, pero no guarda registro de los pedidos.
DB_URI=

# --- Correo (Resend) ---
# Sin la key el API funciona igual, pero no envía la confirmación de compra.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Método SK <hola@metodosk.ec>

SLACK_ERROR_WEBHOOK=

# ── Bunny Stream — el video del método ──────────────────────────────────────
# El archivo sube directo del navegador a Bunny: la key se queda en el servidor.
# Se sacan del panel de Bunny → Stream → tu librería → API.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
# Hostname del pull zone de la librería, p. ej. vz-1a2b3c4d-e5f.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Opcional: solo si activas Token Authentication en la librería.
BUNNY_STREAM_TOKEN_KEY=

# ── Cloudinary — fotos de avance de las alumnas ─────────────────────────────
# Suben directo del navegador; el servidor solo firma. Se guardan como
# `authenticated`: son fotos del cuerpo, no pueden quedar en una URL pública.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Pre-venta ───────────────────────────────────────────────────────────────
# Hasta cuándo comprar incluye la comunidad masiva de Telegram. Quien compra
# después entra igual al reto, pero el grupo se le cobra aparte.
TELEGRAM_DEADLINE=2026-09-14T23:59:59-05:00
# Cuándo se abre el contenido. Hasta entonces la app avisa que es pre-venta.
APERTURA_FECHA=2026-09-15T00:00:00-05:00
