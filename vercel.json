{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/recursos",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/telegram",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/novedad",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/notas",
      "schedule": "45 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
